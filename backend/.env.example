NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/elane

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Scent Intelligence (AI layer) ─────────────────────────────────────────
# Leave AI_PROVIDER=none to run without AI — search falls back gracefully.
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_MS=15000
AI_MAX_QUERY_LENGTH=500
AI_VECTOR_SEARCH=false
AI_CACHE_TTL_MS=300000
